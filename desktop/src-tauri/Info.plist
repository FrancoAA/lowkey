<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS: merged by Tauri into the app's Info.plist. The microphone needs a reason, or macOS
     refuses it (and may end the app) the first time it records. -->
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Lowkey records your voice to turn it into text, on this computer.</string>
</dict>
</plist>
