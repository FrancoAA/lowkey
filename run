#!/usr/bin/env bash
# open-whisper: one command to start. First run installs Python deps, builds the UI and
# downloads the speech model (progress shows here and in the browser). Then it just works.
set -euo pipefail
cd "$(dirname "$0")"

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "open-whisper needs '$1' on this machine. $2" >&2; exit 1; }
}
need uv "Install it from https://docs.astral.sh/uv/getting-started/installation/"

UI_SOURCES="frontend/src frontend/index.html frontend/public frontend/package.json frontend/package-lock.json frontend/vite.config.ts frontend/tsconfig.json"
# shellcheck disable=SC2086
if [ ! -f frontend/dist/index.html ] ||
   [ -n "$(find $UI_SOURCES -newer frontend/dist/index.html -print -quit)" ]; then
  need node "Install Node.js 20 or newer from https://nodejs.org"
  need npm "Install Node.js 20 or newer from https://nodejs.org"
  if [ "$(node -p 'process.versions.node.split(".")[0]')" -lt 20 ]; then
    echo "open-whisper needs Node.js 20 or newer to build its UI (found $(node -v))." >&2
    exit 1
  fi
  echo "Building the web UI…"
  (
    cd frontend
    if [ ! -d node_modules ] || [ package-lock.json -nt node_modules ]; then
      npm ci --no-fund --no-audit --loglevel=error
    fi
    npm run --silent build >/dev/null
  )
fi

exec uv run --frozen --no-dev python -m openwhisper "$@"
