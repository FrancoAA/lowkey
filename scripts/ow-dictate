#!/bin/sh
# Global dictation control for open-whisper. Bind it to a key in your desktop:
#   ow-dictate press    on key press      (hold = push-to-talk, tap = start/stop)
#   ow-dictate release  on key release
#   ow-dictate toggle   one key, no hold detection
#   ow-dictate cancel   stop without transcribing
action=${1:-toggle}
state="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/open-whisper/server.json"
url=$(sed -n 's/.*"url": *"\([^"]*\)".*/\1/p' "$state" 2>/dev/null)
if [ -n "$url" ] && curl -fsS -m 3 -X POST "$url/api/dictation/$action" >/dev/null 2>&1; then
  exit 0
fi
[ "$action" = release ] && exit 0  # the press already reported the problem
command -v notify-send >/dev/null 2>&1 &&
  notify-send -a open-whisper "open-whisper is not running" "Start it with ./run in the open-whisper folder."
exit 1
